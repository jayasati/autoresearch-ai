# ============================================================
# AutoResearch AI -- environment template
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ============================================================

# ---------- Application ----------
APP_NAME=AutoResearch AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Only the root prefix is configurable; /api/v1 and /api/health are derived from it.
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# ---------- Foundation model: OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3

# ---------- Embeddings: Sentence Transformers (local, no key) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ---------- Vector store: ChromaDB (local, persistent) ----------
CHROMA_PERSIST_DIR=../data/vectorstore
CHROMA_COLLECTION=autoresearch_evidence

# ---------- Web search: Tavily ----------
# https://app.tavily.com/  (free tier available)
TAVILY_API_KEY=tvly-replace-me
TAVILY_MAX_RESULTS=8

# ---------- Academic search: Semantic Scholar ----------
# Public API works without a key; a key raises rate limits.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_RESULTS=10

# ---------- Structured data: PostgreSQL ----------
# The ONE place the connection string lives. Never split into host/user/password
# settings: one URL is what psql, Alembic and every hosting platform already
# understand, and splitting it would create four places a credential could leak
# instead of one.
#
# CHANGEME is deliberate. A fresh checkout must fail to connect rather than
# silently reaching a real database, and /api/v1/system/capabilities reports
# postgres as "not configured" while this placeholder is present.
#
# `postgresql://` and `postgres://` are both accepted and rewritten to pin the
# psycopg driver -- paste a URL from a hosting dashboard and it will work.
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/autoresearch

# Connection pool. A deployment running N workers multiplies these, so
# PostgreSQL's max_connections must be at least N * (POOL_SIZE + MAX_OVERFLOW).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Bounded connect, so an unreachable host cannot hang the readiness probe.
DB_CONNECT_TIMEOUT=5
# Log every SQL statement. Noisy; useful when debugging a query.
DB_ECHO=false

# ---------- Retrieval defaults ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6

# ---------- Cost guardrails (important for a student budget) ----------
MAX_SUBQUESTIONS=6
MAX_SOURCES_PER_RUN=25
MAX_LLM_CALLS_PER_RUN=40
