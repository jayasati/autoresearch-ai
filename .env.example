# ============================================================
# AutoResearch AI -- environment template
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ============================================================

# ---------- Application ----------
APP_NAME=AutoResearch AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Only the root prefix is configurable; /api/v1 and /api/health are derived from it.
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# ---------- Foundation model: OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3

# ---------- Embeddings: Sentence Transformers (local, no key) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ---------- Vector store: ChromaDB (local, persistent) ----------
CHROMA_PERSIST_DIR=../data/vectorstore
CHROMA_COLLECTION=autoresearch_evidence

# ---------- Web search: Tavily ----------
# https://app.tavily.com/  (free tier available)
TAVILY_API_KEY=tvly-replace-me
TAVILY_BASE_URL=https://api.tavily.com

# "basic" is one round of retrieval; "advanced" digs deeper and costs more credits.
# Configurable because the benchmark will hold it constant across modes, and because
# it is a real cost lever.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8

# Total time for one search, including connect.
TAVILY_TIMEOUT_SECONDS=20

# Attempts, not retries: 3 means one try plus two more. Only timeouts, 429s and 5xx
# are retried -- a bad API key never succeeds, so retrying it only delays the error.
TAVILY_MAX_ATTEMPTS=3
TAVILY_BACKOFF_BASE_SECONDS=0.5
TAVILY_BACKOFF_MAX_SECONDS=10

# ---------- Academic search: Semantic Scholar ----------
# The public API works WITHOUT a key; a key only raises the quota. So leaving this
# blank is a valid configuration, unlike every other credential in this file.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
SEMANTIC_SCHOLAR_MAX_RESULTS=10

# ONE REQUEST PER SECOND, cumulative across all endpoints -- the provider's documented
# limit, and it asks callers to stay below it. This is a client-side throttle applied
# before sending, not just 429 handling.
#
# 1.25 rather than 1.1 on evidence: three real requests spaced 1.1s apart still drew
# one 429. The retry absorbed it, but a rejection costs a round trip and a backoff, so
# a little more headroom is cheaper than the retry it avoids.
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.25

# Longer than Tavily's: the provider is slower, and a throttled request may wait a
# second before it is even sent.
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=30

# One more attempt than Tavily, because a 429 here is expected rather than anomalous.
SEMANTIC_SCHOLAR_MAX_ATTEMPTS=4
SEMANTIC_SCHOLAR_BACKOFF_BASE_SECONDS=1.0
SEMANTIC_SCHOLAR_BACKOFF_MAX_SECONDS=30

# ---------- Structured data: PostgreSQL ----------
# The ONE place the connection string lives. Never split into host/user/password
# settings: one URL is what psql, Alembic and every hosting platform already
# understand, and splitting it would create four places a credential could leak
# instead of one.
#
# CHANGEME is deliberate. A fresh checkout must fail to connect rather than
# silently reaching a real database, and /api/v1/system/capabilities reports
# postgres as "not configured" while this placeholder is present.
#
# `postgresql://` and `postgres://` are both accepted and rewritten to pin the
# psycopg driver -- paste a URL from a hosting dashboard and it will work.
DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/autoresearch

# Connection pool. A deployment running N workers multiplies these, so
# PostgreSQL's max_connections must be at least N * (POOL_SIZE + MAX_OVERFLOW).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Bounded connect, so an unreachable host cannot hang the readiness probe.
DB_CONNECT_TIMEOUT=5
# Log every SQL statement. Noisy; useful when debugging a query.
DB_ECHO=false

# ---------- Retrieval defaults ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6

# ---------- Cost guardrails (important for a student budget) ----------
MAX_SUBQUESTIONS=6
MAX_SOURCES_PER_RUN=25
MAX_LLM_CALLS_PER_RUN=40
